isEmpty(OSGEARTH_DIR): OSGEARTH_DIR = $$OSGEARTH_ROOT
isEmpty(OSGEARTH_DIR): OSGEARTH_DIR = $$OSG_ROOT
isEmpty(OSGEARTH_DIR): OSGEARTH_DIR = $$(OSGEARTH_DIR)
isEmpty(OSGEARTH_DIR): OSGEARTH_DIR = $$(OSGEARTH_ROOT)

isEmpty(OSGEARTH_DIR) {
    error("OSGEARTH_DIR is not defined")
}

# -----------------------------------------------------------------------------
# 2. Candidate paths — mirrors CMake HINTS / PATHS lists
# -----------------------------------------------------------------------------
OSGEARTH_INCLUDE_CANDIDATES = $$OSGEARTH_DIR/include $$OSGEARTH_DIR
OSGEARTH_LIB_CANDIDATES     = $$OSGEARTH_DIR/lib $$OSGEARTH_DIR/lib64 $$OSGEARTH_DIR

# -----------------------------------------------------------------------------
# 3. find_path(osgEarth/Common)
#    Iterates candidates and takes the first one that contains the sentinel
#    header — identical to CMake's find_path behaviour.
# -----------------------------------------------------------------------------
OSGEARTH_INCLUDE_DIR =
for(candidate, OSGEARTH_INCLUDE_CANDIDATES) {
    isEmpty(OSGEARTH_INCLUDE_DIR):exists($$candidate/osgEarth/Common) {
        OSGEARTH_INCLUDE_DIR = $$candidate
    }
}

# -----------------------------------------------------------------------------
# 4. find_library(osgEarth)
#    Checks for the import/shared library by platform convention.
# -----------------------------------------------------------------------------
win32: _oe_lib_file = osgEarth.lib
else:macx: _oe_lib_file = libosgEarth.dylib
else: _oe_lib_file = libosgEarth.so

OSGEARTH_LIB_DIR =
for(candidate, OSGEARTH_LIB_CANDIDATES) {
    isEmpty(OSGEARTH_LIB_DIR):exists($$candidate/$$_oe_lib_file) {
        OSGEARTH_LIB_DIR = $$candidate
    }
}

# -----------------------------------------------------------------------------
# 5. Version detection — parse osgEarth/Version (like CMake's version header
#    parsing in find_package).  Uses platform-appropriate shell commands.
# -----------------------------------------------------------------------------
OSGEARTH_VERSION =
OSGEARTH_VERSION_HEADER = $$OSGEARTH_INCLUDE_DIR/osgEarth/Version
exists($$OSGEARTH_VERSION_HEADER) {
    OSGEARTH_VERSION_LINES = $$cat($$OSGEARTH_VERSION_HEADER, lines)
    for(_line, OSGEARTH_VERSION_LINES) {
        _norm = $$replace(_line, "[\t ]+", " ")
        _norm = $$replace(_norm, "^ ", "")
        contains(_norm, "OSGEARTH_MAJOR_VERSION") {
            _VER_MAJ = $$section(_norm, " ", -1, -1)
        }
        contains(_norm, "OSGEARTH_MINOR_VERSION") {
            _VER_MIN = $$section(_norm, " ", -1, -1)
        }
        contains(_norm, "OSGEARTH_PATCH_VERSION") {
            _VER_PAT = $$section(_norm, " ", -1, -1)
        }
    }
    !isEmpty(_VER_MAJ):!isEmpty(_VER_MIN):!isEmpty(_VER_PAT): OSGEARTH_VERSION = $${_VER_MAJ}.$${_VER_MIN}.$${_VER_PAT}
}

# -----------------------------------------------------------------------------
# 6. find_package_handle_standard_args equivalent
#    Fatal error when either the headers or the core library cannot be found.
# -----------------------------------------------------------------------------
isEmpty(OSGEARTH_INCLUDE_DIR)|isEmpty(OSGEARTH_LIB_DIR) {
    error("FindOSGEARTH: osgEarth not found. \
Set OSGEARTH_DIR/OSGEARTH_ROOT/OSG_ROOT (qmake var or env var) or DEPS_ROOT. \
Searched: $$OSGEARTH_DIR")
}
OSGEARTH_FOUND = true

# -----------------------------------------------------------------------------
# 7. Apply to the current target
# -----------------------------------------------------------------------------
INCLUDEPATH += $$OSGEARTH_INCLUDE_DIR
LIBS        += -L$$OSGEARTH_LIB_DIR

# OSG base libraries required by osgEarth
LIBS += -losg -losgDB -losgUtil -losgGA \
        -losgViewer -losgManipulator -losgTerrain \
        -losgText -losgShadow -lOpenThreads

# osgEarth core library
LIBS += -losgEarth

# GDAL is required by MapLoadModuleDialog::getAttributes (GDALAllRegister).
win32 {
    exists($$OSGEARTH_LIB_DIR/gdal.lib) {
        LIBS += -lgdal
    } else:exists($$OSGEARTH_LIB_DIR/gdal_i.lib) {
        LIBS += -lgdal_i
    } else {
        warning("FindOSGEARTH: GDAL import library not found in $$OSGEARTH_LIB_DIR")
    }
} else {
    LIBS += -lgdal
}

# Optional: ImGui overlay — linked only when the import library is present
win32 {
    exists($$OSGEARTH_LIB_DIR/osgEarthImGui.lib): LIBS += -losgEarthImGui
} else:macx {
    exists($$OSGEARTH_LIB_DIR/libosgEarthImGui.dylib): LIBS += -losgEarthImGui
} else {
    exists($$OSGEARTH_LIB_DIR/libosgEarthImGui.so): LIBS += -losgEarthImGui
}

# Qt–OSG bridge
LIBS += -losgQOpenGL -lopengl32

# Silent by default to avoid repeated qmake noise across subprojects.
# Enable only when debugging dependency resolution:
#   qmake CONFIG+=osgearth_verbose
contains(CONFIG, osgearth_verbose) {
    !isEmpty(OSGEARTH_VERSION) {
        message("FindOSGEARTH: found osgEarth $$OSGEARTH_VERSION at $$OSGEARTH_DIR")
    } else {
        message("FindOSGEARTH: found osgEarth (version unknown) at $$OSGEARTH_DIR")
    }
}
