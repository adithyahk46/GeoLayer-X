QWidget {
    background-color: #2e2e34;
    color: #ffffff;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}

QMainWindow,
QDialog {
    background-color: #2e2e34;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #2d2d2d;
    color: #ffffff;
}

QTreeView,
QTreeWidget,
QTableView,
QTableWidget,
QListView,
QListWidget {
    background-color: #2d2d2d;
    alternate-background-color: #001a68;
    color: #ffffff;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}

QPushButton,
QToolButton {
    background-color: #3c3c3c;
    color: #ffffff;
}

QToolTip {
    background-color: #3c3c3c;
    color: #d4d4d4;
}

QLabel,
QStatusBar {
    color: #ffffff;
}