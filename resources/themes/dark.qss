/* Dark Theme Palette */

QWidget {
    background-color: #28282a;
    color: #ffffff;
    selection-background-color: #89b4fa;
    selection-color: #11111b;
}

QMainWindow, QDialog { background-color: #181825; }

QToolTip {
    background-color: #313244;
    color: #cdd6f4;
    border-color: #45475a;
}

QPushButton {
    background-color: #313244;
    color: #cdd6f4;
    border-color: #45475a;
}
QPushButton:hover { background-color: #45475a; border-color: #585b70; }
QPushButton:pressed { background-color: #89b4fa; color: #11111b; }

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox {
    background-color: #11111b;
    color: #cdd6f4;
    border-color: #45475a;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus {
    border-color: #89b4fa;
}

QTabBar::tab {
    background-color: #181825;
    color: #a6adc8;
    border-color: #313244;
}
QTabBar::tab:selected {
    background-color: #1e1e2e;
    color: #89b4fa;
    border-top: 2px solid #89b4fa;
}

QScrollBar:vertical { background-color: #181825; }
QScrollBar::handle:vertical { background-color: #45475a; }